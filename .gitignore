# 白名单模式：先忽略所有，再显式指定要跟踪的
*

# 根目录配置文件
!.gitignore
!.gitmodules
!.mill-version
!Makefile
!build.sc
!Kconfig

# 源代码
!src/
!src/**

# 外设 Verilog
!perip/
!perip/**

# 构建脚本
!scripts/
!scripts/**

# 资源文件
!resource/
!resource/**

# rocket-chip 子模块
!rocket-chip/
!rocket-chip/**

# 头文件（include 跟踪，但 config/generated 不跟踪）
!include/
!include/**

# Kconfig 生成的文件（不跟踪）
include/config
include/generated
.config
.config.old

# flex/bison 生成的文件（不跟踪）
src/cxx/monitor/sdb/expr.tab.c
src/cxx/monitor/sdb/expr.lex.c
src/cxx/monitor/sdb/expr.tab.h
